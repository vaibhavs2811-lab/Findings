# Copy to .streamlit/secrets.toml (gitignored) and fill in real values.
# The Supabase secret key / service_role key NEVER goes in this file or in Streamlit Cloud.
SUPABASE_URL = "https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_PUBLISHABLE_KEY = "sb_publishable_REPLACE_ME"

# Gemini key belongs in Streamlit Cloud Secrets and in your global ~/.streamlit/secrets.toml
# (e.g. C:\Users\you\.streamlit\secrets.toml), and never in the committed project .streamlit/secrets.toml.
# GEMINI_API_KEY = "REPLACE_ME"
